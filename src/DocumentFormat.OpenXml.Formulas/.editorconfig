root = true

[*.cs]

# SA1636: File header copyright text should match
# Disabled for this project due to mixed Microsoft/Matt Liotta copyrights
dotnet_diagnostic.SA1636.severity = none

# SA1402: File may only contain a single type
# Disabled for FormulaNode.cs and Result.cs where multiple related types are intentional
dotnet_diagnostic.SA1402.severity = none

# SA1513: Closing brace should be followed by blank line
# Disabled - widespread formatting style across 500+ function files
dotnet_diagnostic.SA1513.severity = none
